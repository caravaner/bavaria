{
  "name": "bavaria",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "devs": "npm run dev:admin & npm run dev:web",
    "dev:web": "npm run dev -w @bavaria/web",
    "dev:admin": "npm run dev -w @bavaria/admin",
    "build": "npm run db:generate && npm run db:migrate:deploy && npm run build -w @bavaria/admin && npm run build -w @bavaria/web",
    "db:generate": "npm run generate -w @bavaria/db",
    "db:migrate": "npm run migrate -w @bavaria/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @bavaria/db",
    "db:seed": "npm run seed -w @bavaria/db",
    "db:studio": "npm run studio -w @bavaria/db",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
