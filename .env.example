# Copy to .env.local (git-ignored). Both apps + the seed load this single
# repo-root file via scripts/with-env.mjs.

# ── Database (used by the admin app + packages/db migrations/seed only) ───────
# Pooled connection for the running app:
DATABASE_URL="postgresql://user:pass@host:5432/bavaria?schema=main"
# Direct (unpooled) connection for prisma migrate / seed:
DIRECT_URL="postgresql://user:pass@host:5432/bavaria?schema=main"

# ── Admin app (apps/admin) ───────────────────────────────────────────────────
# Secret used to sign admin session cookies. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-32-bytes-random"
# Shared secret for internal web↔admin API calls (orders/capture). Generate likewise.
API_INTERNAL_SECRET="change-me-shared-secret"

# Seed account (optional; defaults to superuser / password)
# SEED_ADMIN_USERNAME="superuser"
# SEED_ADMIN_PASSWORD="password"

# PayPal (server-side; lives in the admin app now)
PAYPAL_ENV="sandbox"            # sandbox | live
# PAYPAL_API_BASE=""            # optional override; derived from PAYPAL_ENV otherwise
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_WEBHOOK_ID="..."         # from the PayPal dashboard webhook pointing at admin /api/paypal/webhook

# ── Email (admin app sends; @bavaria/email transport) ────────────────────────
# SMTP is provider-agnostic. Point it at Mailpit in dev, Strato (or any SMTP
# host) in prod.
#
#   Dev  — run Mailpit:  docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#          then open the inbox UI at http://localhost:8025
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"        # Mailpit accepts plaintext; no SECURE/USER/PASS needed
#
#   Prod (Strato) — confirm exact host/port in your Strato webmail panel:
#   SMTP_HOST="smtp.strato.de"
#   SMTP_PORT="465"         # 465 = implicit TLS; or 587 for STARTTLS
#   SMTP_SECURE="true"      # defaults to (port == 465) when unset
#   SMTP_USER="you@your-domain.de"   # full mailbox address
#   SMTP_PASS="your-mailbox-password"
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""

# From address on every email. With Strato this MUST equal the authenticated
# mailbox (SMTP_USER) or the send is rejected.
EMAIL_FROM="Career Restart <hello@your-domain.de>"
# Reply-To / support address shown to recipients (defaults to EMAIL_FROM).
# EMAIL_REPLY_TO="hello@your-domain.de"
# Owner inbox for internal notices like refunds/disputes (defaults to EMAIL_FROM).
# EMAIL_OWNER="owner@your-domain.de"

# Logo shown in every email header. Email clients need an absolute URL to a
# hosted PNG (not SVG/relative paths), so it defaults to the public web app's
# /images/email-logo.png. Set NEXT_PUBLIC_SITE_URL to your live site so the
# image resolves; or override the full URL with EMAIL_LOGO_URL (e.g. a CDN).
NEXT_PUBLIC_SITE_URL="https://your-domain.de"
# EMAIL_LOGO_URL="https://cdn.your-domain.de/email-logo.png"

# ── Web app (apps/web) ───────────────────────────────────────────────────────
# Base URL of the admin app/API. Dev: http://localhost:3001  Prod: https://admin.yoursite.com
ADMIN_API_URL="http://localhost:3001"
# Public PayPal client id, exposed to the browser for the Smart Buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="..."
# API_INTERNAL_SECRET is shared with the admin app (defined above).
